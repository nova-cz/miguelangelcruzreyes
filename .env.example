# Copia este archivo a .env.local (y agrégalo también en Vercel → Settings → Environment Variables).
# Sin esta clave el chat de la estrella responde "aún no está activado".
ANTHROPIC_API_KEY=

# Opcional: cambia el modelo del chat (por defecto claude-opus-5-5).
# CHAT_MODEL=claude-haiku-5-5

# Ventana de contacto (EmailJS). Son los mismos valores que usabas antes como VITE_APP_EMAILJS_*:
# SERVICE_ID, TEMPLATE_ID y PUBLIC_KEY. La plantilla recibe los campos: name, email, message.
# Sin estos tres valores la ventana abre tu app de correo con el mensaje ya redactado.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
